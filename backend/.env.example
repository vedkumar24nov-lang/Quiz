# PrepLab backend env

# HTTP server
PORT=4000

# Where to store the SQLite file (relative to backend/)
DB_FILE=./data/preplab.db

# Which DB driver to use. v1 only supports "sqlite". Future: "postgres".
DB_DRIVER=sqlite

# CORS origin allowed to call this backend (Vite dev server)
CORS_ORIGIN=http://localhost:5173
