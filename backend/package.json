{
  "name": "preplab-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PrepLab backend — Express + SQLite (via Drizzle ORM). Repository pattern lets us swap SQLite for Postgres later without touching services.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "reset": "rm -f data/preplab.db && npm run seed"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
