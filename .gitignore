# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# TypeScript build cache
*.tsbuildinfo
**/*.tsbuildinfo

# Env files (real secrets — keep .env.example tracked)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# SQLite databases (seeded locally, not part of source)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.suo
*.sln
*.ntvs*
*.njsproj

# OS
.DS_Store
Thumbs.db
desktop.ini

# Coverage / test artifacts
coverage/
.nyc_output/
*.lcov

# Vite cache
.vite/
**/.vite/

# Misc local files
*.local
